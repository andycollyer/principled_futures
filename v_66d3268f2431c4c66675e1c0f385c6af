                        </table>
                        <table width="100%" border="0" cellspacing="0" cellpadding="0">
                           <col width="4%"/>
                           <col width="96%"/>
                           <tbody>
                              <tr>
                                 <td valign="top"  >
                                    <p class="oj-normal">(b)</p>
                                 </td>
                                 <td valign="top"  >
                                    <p class="oj-normal">[Voluntary for undertakings with 10 employees or less] the proportion of waste diverted to <span class="oj-bold">
                                          <span class="oj-italic">recycling</span>
                                       </span> or preparation for reuse;</p>
                                 </td>
