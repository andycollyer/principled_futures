# Principled Futures — environment template. SAFE to commit (no real values).
# Copy to .env.local and fill in. Set the same vars in Netlify (server-side).

# Client-safe (browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SECRET — server-side only. Set in Netlify env vars, never in client code.
SUPABASE_SECRET_KEY=sb_secret_...
